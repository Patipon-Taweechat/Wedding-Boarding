# Same Supabase project as wedding-invite — this app reads and writes the
# same `rsvps` table, it does not have its own database.
# Copy this file to .env.local and fill in the real values (Supabase
# dashboard > Project Settings > API).

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# service_role key — server-only, never NEXT_PUBLIC_. Same key wedding-invite
# uses for its admin client.
SUPABASE_SERVICE_ROLE_KEY=

# Shared PIN staff enter before the scanner unlocks. Leave unset in local dev
# to skip the lock screen entirely; always set it before the wedding day.
STAFF_PIN=1234
